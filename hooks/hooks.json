{
  "description": "Exports the Claude Code session id so logged Jev calls are tagged with it. Prints nothing.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-env.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
